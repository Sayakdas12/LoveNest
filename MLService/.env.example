# LoveNest ML Service — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB (same URI as Node.js backend — read-only from Python)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lovenest

# Groq API Key (same as Node.js GROQ_API_KEY)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Python service port (must match ML_SERVICE_URL in Node.js .env)
PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info
